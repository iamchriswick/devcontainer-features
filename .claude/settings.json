{
  "autoMemoryDirectory": ".claude/memory",
  "sandbox": {
    "enabled": false
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/if-cloud-env-start-dockerd.sh"
          }
        ]
      }
    ]
  }
}
